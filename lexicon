#!/usr/bin/env bash
set -e

[ -f .env ] || touch .env

(docker compose -f docker-compose-dev.yml up -d 2>&1 | grep -v 'up-to-date') || true

LOCAL_HASH=$(sha1sum Dockerfile docker-compose-dev.yml Gemfile requirements.txt lexicon)
RUNNING_HASH=$(docker compose -f docker-compose-dev.yml exec -T lexicon_runner cat build_hash.sha1)

set +e
DIFF=$(diff -b <(echo $LOCAL_HASH) <(echo $RUNNING_HASH))
set -e

if [[ "$DIFF" != "" ]];
then
  echo -e "\033[31mYour installation of the lexicon seems to be outdated. Updating...\033[00m"
  docker compose -f docker-compose-dev.yml build

  echo -e "\033[32mRestarting...\033[00m"
  (docker compose -f docker-compose-dev.yml up -d 2>&1 | grep -v 'up-to-date') || true
fi

# The web interface of contributions runs in a container of its own: it publishes a port on this machine
# only, and may write in data/contributions, which the runner reads but does not write.
if [[ "$1" == "contribute" && " $* " == *" --web "* ]];
then
  PORT=${LEXICON_CONTRIBUTE_PORT:-8787}
  mkdir -p data/contributions
  exec docker compose -f docker-compose-dev.yml run --rm \
    -p "127.0.0.1:$PORT:8787" \
    -v "$PWD/data/contributions:/lexicon/data/contributions:rw" \
    -e "LEXICON_CONTRIBUTE_URL=http://localhost:$PORT" \
    lexicon_runner ./lexicon-cli "$@"
fi

# Bringing in a dataset proposed online writes in data/contributions too
if [[ "$1" == "contribute" && " $* " == *" --fetch "* ]];
then
  mkdir -p data/contributions
  exec docker compose -f docker-compose-dev.yml run --rm \
    -v "$PWD/data/contributions:/lexicon/data/contributions:rw" \
    lexicon_runner ./lexicon-cli "$@"
fi

exec docker compose -f docker-compose-dev.yml exec lexicon_runner ./lexicon-cli "$@"
